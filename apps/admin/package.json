{
  "name": "@lumi-draw/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:v2": "tsc --noEmit && cross-env LUMI_ADMIN_BASE=/admin-v2/ vite build",
    "build:test": "tsc --noEmit && cross-env VITE_ENABLE_MOCK_DATA=true LUMI_ADMIN_BASE=/ vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@lumi-draw/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^5.27.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.1",
    "remixicon": "4.6.0"
  },
  "devDependencies": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "cross-env": "^10.1.0",
    "typescript": "5.4.5",
    "vite": "5.2.8"
  }
}
